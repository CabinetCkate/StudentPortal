@model IEnumerable<StudentPortal.Models.Student>

@{
    ViewData["Title"] = "Студенттер";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Студенттер тізімі</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Студент қосу</a>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Аты-жөні</th>
            <th>Email</th>
            <th>Тобы</th>
            <th>Қабылданған күні</th>
            <th>Әрекеттер</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var student in Model)
    {
        <tr>
            <td>@student.FullName</td>
            <td>@student.Email</td>
            <td>@student.Group</td>
            <td>@student.EnrollmentDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Details" asp-route-id="@student.Id">Толығырақ</a>
                @if (User.IsInRole("Admin"))
                {
                    <span> | </span>
                    <a asp-action="Edit" asp-route-id="@student.Id">Өңдеу</a>
                    <span> | </span>
                    @* Бұл батырманы жасыру — тек UI ыңғайлылығы; нақты қорғаныс контроллердегі [Authorize(Roles = "Admin")]. *@
                    <form asp-action="Delete" asp-route-id="@student.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Осы студентті жоюға сенімдісіз бе?');">
                        <button type="submit" class="btn btn-link p-0 align-baseline">Жою</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
