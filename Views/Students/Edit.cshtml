@model StudentPortal.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Студентті өңдеу";
}

<h1>Студентті өңдеу</h1>
<form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_StudentForm" model="Model" />
    <button type="submit" class="btn btn-primary">Сақтау</button>
    <a asp-action="Index" class="btn btn-secondary">Болдырмау</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
